# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudflare R2 Storage (Worker API)
# Set this to your deployed Worker URL if it differs from the app's origin.
# Leave empty if the Worker is co-located with your static assets (same domain).
NEXT_PUBLIC_R2_WORKER_URL=

# Discord OAuth & Webhooks (Optional for Phase 4)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_WEBHOOK_URL=your-discord-webhook-url
